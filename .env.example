# Copy to .env and fill in. Never commit .env.

# --- Bedrock (required for chat replies) ---
# A Claude model or cross-region inference profile ID enabled in your account.
# Copy it from the Bedrock console: Model catalog -> your Claude model -> model ID / inference profile ID.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# Credentials: use a named profile (recommended) or the usual AWS_* variables.
AWS_PROFILE=default

# --- Conversation memory (optional) ---
# Leave empty to keep memory in SQLite. Set both to use Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# Rebuild the working database from the snapshot every time the server starts.
SETUHAUL_RESET_ON_START=1
